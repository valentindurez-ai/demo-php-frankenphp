{% extends 'base.html.twig' %}

{% block title %}Une Fois — la Belgique sur Clever Cloud{% endblock %}

{% block stylesheets %}
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --noir: #111111;
    --jaune: #FDDA24;
    --rouge: #EF3340;
    --creme: #FBF6EA;
    --brique: #B5492B;
    --gris: #5b5b5b;
  }
  html, body { background: var(--creme); color: var(--noir); font-family: 'Space Grotesk', sans-serif; }
  h1, h2, h3 { font-family: 'Fraunces', serif; line-height: 1.05; }
  .drapeau { display: flex; height: 10px; position: sticky; top: 0; z-index: 20; }
  .drapeau span { flex: 1; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  nav { display: flex; justify-content: space-between; align-items: center; padding: 22px 0; gap: 16px; flex-wrap: wrap; }
  nav .logo { font-family: 'Fraunces', serif; font-weight: 800; font-size: 26px; }
  nav .logo em { color: var(--rouge); font-style: normal; }
  nav ul { display: flex; gap: 22px; list-style: none; font-weight: 500; flex-wrap: wrap; }
  nav a:hover { color: var(--rouge); }

  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; padding: 50px 0 80px; }
  .hero h1 { font-size: clamp(44px, 7vw, 92px); font-weight: 800; }
  .hero h1 .surligne { background: linear-gradient(transparent 60%, var(--jaune) 60%); }
  .hero p { font-size: 19px; color: var(--gris); margin: 22px 0 30px; max-width: 540px; }
  .badge { display: inline-block; background: var(--noir); color: var(--jaune); padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 700; letter-spacing: .04em; margin-bottom: 18px; }
  .btn { display: inline-block; padding: 14px 26px; border-radius: 12px; font-weight: 700; border: 2px solid var(--noir); cursor: pointer; font-size: 16px; font-family: inherit; transition: transform .15s, box-shadow .15s; }
  .btn:hover { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--noir); }
  .btn-rouge { background: var(--rouge); color: #fff; }
  .btn-jaune { background: var(--jaune); color: var(--noir); }
  .atomium { width: 100%; max-width: 380px; justify-self: center; animation: flotte 6s ease-in-out infinite; }
  @keyframes flotte { 50% { transform: translateY(-14px) rotate(2deg); } }

  section { padding: 80px 0; }
  .titre-section { display: flex; align-items: baseline; gap: 16px; margin-bottom: 36px; flex-wrap: wrap; }
  .titre-section h2 { font-size: clamp(34px, 4.5vw, 54px); }
  .titre-section span { color: var(--gris); }

  /* Frietkot */
  .frietkot { background: var(--noir); color: var(--creme); border-radius: 28px; padding: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .frietkot h2 { color: var(--jaune); }
  .cornet { background: var(--creme); color: var(--noir); border-radius: 20px; padding: 32px; min-height: 230px; display: flex; flex-direction: column; justify-content: center; border: 4px dashed var(--jaune); }
  .cornet .sauce { font-family: 'Fraunces', serif; font-size: 44px; font-weight: 800; }
  .piments { font-size: 22px; margin: 8px 0 12px; letter-spacing: 2px; }
  .cornet .note { color: var(--gris); }
  .worker { margin-top: 26px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .worker div { background: #222; border-radius: 14px; padding: 14px; }
  .worker b { display: block; font-size: 26px; color: var(--jaune); font-family: 'Fraunces', serif; }
  .worker small { color: #aaa; font-size: 12px; }
  .pop { animation: pop .35s ease-out; }
  @keyframes pop { 0% { transform: scale(.9) rotate(-2deg); opacity: .3; } 100% { transform: none; opacity: 1; } }

  /* Bières */
  .bieres { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; }
  .biere { background: #fff; border: 2px solid var(--noir); border-radius: 18px; padding: 22px; display: flex; gap: 18px; align-items: center; }
  .verre { width: 54px; height: 70px; border: 3px solid var(--noir); border-top: none; border-radius: 0 0 24px 24px; background: linear-gradient(to top, #d98b1f 0 72%, #fff8e5 72% 100%); flex-shrink: 0; position: relative; }
  .biere:nth-child(2) .verre, .biere:nth-child(5) .verre { background: linear-gradient(to top, #e8b13a 0 72%, #fff8e5 72%); }
  .biere:nth-child(3) .verre { background: linear-gradient(to top, #a3172d 0 72%, #f7d4dc 72%); }
  .biere:nth-child(6) .verre { background: linear-gradient(to top, #f3e0a2 0 72%, #fff 72%); }
  .biere h3 { font-size: 24px; }
  .biere p { color: var(--gris); font-size: 14px; margin-top: 4px; }
  .biere .meta { font-size: 13px; margin-top: 8px; font-weight: 700; }

  /* BD */
  .bd { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 18px; }
  .case { background: var(--jaune); border: 3px solid var(--noir); padding: 20px; border-radius: 4px; box-shadow: 6px 6px 0 var(--noir); transition: transform .2s; }
  .case:nth-child(even) { background: #fff; transform: rotate(1.5deg); }
  .case:nth-child(3n) { background: var(--rouge); color: #fff; transform: rotate(-1.5deg); }
  .case:hover { transform: rotate(0) scale(1.04); }
  .case .emoji { font-size: 42px; }
  .case h3 { font-size: 22px; margin: 10px 0 4px; }
  .case p { font-size: 13px; }

  /* Dico */
  .dico { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .carte { perspective: 900px; height: 150px; cursor: pointer; }
  .carte-inner { position: relative; width: 100%; height: 100%; transition: transform .5s; transform-style: preserve-3d; }
  .carte.retournee .carte-inner { transform: rotateY(180deg); }
  .face { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 16px; display: flex; align-items: center; justify-content: center; padding: 18px; text-align: center; border: 2px solid var(--noir); }
  .face.recto { background: #fff; font-family: 'Fraunces', serif; font-size: 24px; font-weight: 800; }
  .face.verso { background: var(--noir); color: var(--jaune); transform: rotateY(180deg); font-size: 15px; }

  .slogan { background: var(--rouge); color: #fff; text-align: center; padding: 60px 20px; }
  .slogan p { font-family: 'Fraunces', serif; font-size: clamp(26px, 4vw, 44px); font-weight: 800; max-width: 900px; margin: 0 auto 26px; }
  footer { padding: 30px 0; font-size: 14px; color: var(--gris); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  code { background: #00000010; padding: 2px 6px; border-radius: 6px; }

  @media (max-width: 860px) {
    .hero, .frietkot { grid-template-columns: 1fr; }
    .frietkot { padding: 28px; }
    .atomium { max-width: 240px; }
    nav ul { gap: 14px; font-size: 14px; }
  }
</style>
{% endblock %}

{% block body %}
<div class="drapeau"><span style="background:var(--noir)"></span><span style="background:var(--jaune)"></span><span style="background:var(--rouge)"></span></div>

<div class="wrap">
  <nav>
    <a href="/" class="logo">Une <em>Fois</em>.</a>
    <ul>
      <li><a href="#frietkot">Frietkot</a></li>
      <li><a href="#bieres">Bières</a></li>
      <li><a href="#bd">BD</a></li>
      <li><a href="#dico">Dico</a></li>
      <li><a href="/api/belgique">API</a></li>
    </ul>
  </nav>

  <header class="hero">
    <div>
      <span class="badge">🇧🇪 FRANKENPHP · WORKER MODE · CLEVER CLOUD</span>
      <h1>La Belgique, <span class="surligne">servie chaude</span> en PHP.</h1>
      <p>Frites, trappistes, bandes dessinées et septante façons de dire « une fois ». Une app Symfony qui tourne en worker mode : le PHP reste en mémoire, comme l'odeur de la friture après un passage au frietkot.</p>
      <a href="#frietkot" class="btn btn-rouge">Commander un cornet</a>
      <a href="/api/frites" class="btn btn-jaune">Voir l'API</a>
    </div>

    {# Atomium stylisé #}
    <svg class="atomium" viewBox="0 0 300 340" xmlns="http://www.w3.org/2000/svg" aria-label="Atomium">
      <g stroke="#111" stroke-width="6" stroke-linecap="round">
        <line x1="150" y1="40" x2="150" y2="260"/>
        <line x1="60" y1="90" x2="240" y2="230"/>
        <line x1="240" y1="90" x2="60" y2="230"/>
        <line x1="60" y1="90" x2="240" y2="90"/>
        <line x1="60" y1="230" x2="240" y2="230"/>
        <line x1="60" y1="90" x2="60" y2="230"/>
        <line x1="240" y1="90" x2="240" y2="230"/>
        <line x1="150" y1="260" x2="110" y2="330"/>
        <line x1="150" y1="260" x2="190" y2="330"/>
      </g>
      <g stroke="#111" stroke-width="5">
        <circle cx="150" cy="40" r="26" fill="#FDDA24"/>
        <circle cx="60" cy="90" r="26" fill="#EF3340"/>
        <circle cx="240" cy="90" r="26" fill="#111"/>
        <circle cx="150" cy="160" r="30" fill="#FDDA24"/>
        <circle cx="60" cy="230" r="26" fill="#111"/>
        <circle cx="240" cy="230" r="26" fill="#EF3340"/>
        <circle cx="150" cy="260" r="26" fill="#FBF6EA"/>
      </g>
    </svg>
  </header>
</div>

<section id="frietkot">
  <div class="wrap">
    <div class="frietkot">
      <div>
        <h2 style="font-size:clamp(34px,4.5vw,54px)">Le Frietkot du worker</h2>
        <p style="margin:16px 0 24px;color:#ccc">Chaque clic appelle <code style="background:#333">/api/frites</code>. Le compteur vit dans une propriété statique PHP : en worker mode, il survit entre les requêtes. En PHP-FPM classique, il retomberait à zéro à chaque fois.</p>
        <button class="btn btn-jaune" id="commander">Une frite, s'il vous plaît 🍟</button>
        <div class="worker">
          <div><b id="w-frites">{{ worker.frites_servies }}</b><small>cornets servis</small></div>
          <div><b id="w-pid">{{ worker.pid }}</b><small>PID du worker</small></div>
          <div><b id="w-uptime">{{ worker.ouvert_depuis_s }}s</b><small>frietkot ouvert</small></div>
        </div>
      </div>
      <div class="cornet" id="cornet">
        <small style="font-weight:700;letter-spacing:.08em;color:var(--brique)">GRAND CORNET AVEC…</small>
        <div class="sauce" id="sauce">?</div>
        <div class="piments" id="piments"></div>
        <div class="note" id="note">Cliquez pour découvrir votre sauce. Pas de ketchup, on n'est pas des sauvages.</div>
      </div>
    </div>
  </div>
</section>

<section id="bieres">
  <div class="wrap">
    <div class="titre-section"><h2>Bières à servir dans le bon verre</h2><span>Patrimoine immatériel de l'UNESCO depuis 2016.</span></div>
    <div class="bieres">
      {% for b in bieres %}
        <div class="biere">
          <div class="verre"></div>
          <div>
            <h3>{{ b.style }}</h3>
            <p>{{ b.exemple }}</p>
            <div class="meta">{{ b.degre }} · verre {{ b.verre|lower }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="bd" style="background:#fff;border-top:2px solid var(--noir);border-bottom:2px solid var(--noir)">
  <div class="wrap">
    <div class="titre-section"><h2>Le 9ᵉ art est belge</h2><span>Bruxelles compte plus de 50 fresques BD.</span></div>
    <div class="bd">
      {% for h in bd %}
        <div class="case">
          <div class="emoji">{{ h.emoji }}</div>
          <h3>{{ h.titre }}</h3>
          <p>{{ h.auteur }} · {{ h.annee }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="dico">
  <div class="wrap">
    <div class="titre-section"><h2>Petit dico belge</h2><span>Cliquez sur une carte pour la retourner, une fois.</span></div>
    <div class="dico">
      {% for d in dico %}
        <div class="carte" onclick="this.classList.toggle('retournee')">
          <div class="carte-inner">
            <div class="face recto">{{ d.mot }}</div>
            <div class="face verso">{{ d.sens }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<div class="slogan">
  <p id="slogan">« {{ slogan }} »</p>
  <a href="https://www.clever-cloud.com" class="btn btn-jaune">Déployer sur Clever Cloud</a>
</div>

<div class="wrap">
  <footer>
    <span>Une Fois · Symfony 7 + FrankenPHP · hébergé en Europe 🇪🇺</span>
    <span>Fait avec ❤️ et beaucoup d'andalouse.</span>
  </footer>
</div>
{% endblock %}

{% block javascripts %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('commander');
    const cornet = document.getElementById('cornet');
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        const r = await fetch('/api/frites');
        const data = await r.json();
        document.getElementById('sauce').textContent = data.sauce.nom;
        document.getElementById('piments').textContent = data.sauce.piquant ? '🌶️'.repeat(data.sauce.piquant) : '😌 doux';
        document.getElementById('note').textContent = data.sauce.note;
        document.getElementById('w-frites').textContent = data.worker.frites_servies;
        document.getElementById('w-pid').textContent = data.worker.pid;
        document.getElementById('w-uptime').textContent = data.worker.ouvert_depuis_s + 's';
        document.getElementById('slogan').textContent = '« ' + data.slogan + ' »';
        cornet.classList.remove('pop'); void cornet.offsetWidth; cornet.classList.add('pop');
      } catch (e) {
        document.getElementById('note').textContent = 'Le frietkot est fermé (drache ?). Réessayez.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
{% endblock %}
